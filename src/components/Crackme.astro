---
import { disassemble } from '../scripts/crackme';

const lines = disassemble();
---

<div class="cm" data-cm>
  <div class="cm-head">
    <span class="cm-name">crackme_01</span>
    <span class="cm-hint">everything you need is right here</span>
    <span class="cm-status" data-status>LOCKED</span>
  </div>

  <div class="cm-body">
    <div class="cm-disasm" data-disasm aria-label="Bytecode disassembly">
      {lines.map((l, i) => <div class="cm-line" data-pc={i}>{l}</div>)}
    </div>

    <div class="cm-side">
      <p class="cm-copy">
        A stack VM checks a key. The bytecode is on the left, the constants are
        not hidden, and the arithmetic inverts. No devtools needed — though
        nobody's stopping you.
      </p>

      <label class="cm-label">
        <span>key</span>
        <input
          type="text"
          data-key
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          placeholder="try something"
          aria-label="Crackme key input"
        />
      </label>

      <p class="cm-verdict" data-verdict>waiting</p>
    </div>
  </div>
</div>

<script>
  import { run, PROGRAM, OPS } from '../scripts/crackme';

  function initCrackme(root: HTMLElement) {
    const disasm = root.querySelector<HTMLElement>('[data-disasm]')!;
    const keyIn = root.querySelector<HTMLInputElement>('[data-key]')!;
    const verdict = root.querySelector<HTMLElement>('[data-verdict]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const lineEls = Array.from(root.querySelectorAll<HTMLElement>('.cm-line'));

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let solved = false;
    let pc = 0;
    let timer: number | undefined;

    // Idle attract-mode input, so the VM is always doing something.
    const IDLE = ['deadbeef', 'password', '13371337', 'aaaaaaaa'];
    let idleIdx = 0;

    function currentInput(): string {
      return keyIn.value.length ? keyIn.value : IDLE[idleIdx];
    }

    function paint() {
      const input = currentInput();
      const res = run(input);

      lineEls.forEach((el, i) => {
        el.classList.toggle('on', i === pc);
        const instr = PROGRAM[i];
        const failed = !res.ok && res.failedAt === i;
        el.classList.toggle('bad', failed);
        el.classList.toggle('cmp', instr.op === OPS.CMP);
      });

      // Keep the executing line in view without yanking the whole page.
      const active = lineEls[pc];
      if (active && !reduced) {
        const box = disasm.getBoundingClientRect();
        const line = active.getBoundingClientRect();
        if (line.top < box.top || line.bottom > box.bottom) {
          disasm.scrollTop = active.offsetTop - disasm.clientHeight / 2;
        }
      }
    }

    function evaluate() {
      if (!keyIn.value.length) {
        verdict.textContent = 'waiting';
        verdict.className = 'cm-verdict';
        return;
      }
      const res = run(keyIn.value);
      if (res.ok) {
        if (!solved) unlock();
        return;
      }
      const why =
        keyIn.value.length !== 8
          ? `LEN rejected — wants 8, got ${keyIn.value.length}`
          : `CMP rejected at ${PROGRAM[res.failedAt].at.toString(16).padStart(4, '0')}`;
      verdict.textContent = why;
      verdict.className = 'cm-verdict bad';
    }

    function unlock() {
      solved = true;
      root.classList.add('solved');
      status.textContent = 'UNLOCKED';
      verdict.textContent = 'nice. that is the whole idea — see you in the posts.';
      verdict.className = 'cm-verdict good';
      if (!reduced) burst();
    }

    // A small, cheap celebration. No library, no canvas — just some divs.
    function burst() {
      for (let i = 0; i < 22; i++) {
        const p = document.createElement('i');
        p.className = 'cm-spark';
        const angle = (Math.PI * 2 * i) / 22;
        const dist = 40 + Math.random() * 70;
        p.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
        p.style.setProperty('--dy', `${Math.sin(angle) * dist}px`);
        p.style.animationDelay = `${Math.random() * 90}ms`;
        root.querySelector('.cm-head')!.appendChild(p);
        setTimeout(() => p.remove(), 1200);
      }
    }

    keyIn.addEventListener('input', () => {
      if (solved && !run(keyIn.value).ok) {
        solved = false;
        root.classList.remove('solved');
        status.textContent = 'LOCKED';
      }
      evaluate();
      paint();
    });

    if (reduced) {
      pc = 0;
      paint();
    } else {
      timer = window.setInterval(() => {
        pc = (pc + 1) % PROGRAM.length;
        if (pc === 0 && !keyIn.value.length) idleIdx = (idleIdx + 1) % IDLE.length;
        paint();
      }, 55);
    }

    // Stop the loop when the page isn't visible — no point burning a timer.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && timer) {
        clearInterval(timer);
        timer = undefined;
      } else if (!document.hidden && !timer && !reduced) {
        timer = window.setInterval(() => {
          pc = (pc + 1) % PROGRAM.length;
          paint();
        }, 55);
      }
    });

    paint();
  }

  document.querySelectorAll<HTMLElement>('[data-cm]').forEach(initCrackme);
</script>

<style>
  .cm {
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: border-color .3s ease;
  }
  .cm.solved { border-color: var(--ch-d); }

  .cm-head {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--rule-soft);
    background: var(--surface-2);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .cm-name { color: var(--ink); font-weight: 700; }
  .cm-hint { color: var(--muted); letter-spacing: .06em; text-transform: none; font-size: 11.5px; }
  .cm-status {
    margin-left: auto;
    color: var(--ch-alert);
    font-weight: 700;
  }
  .cm.solved .cm-status { color: var(--ch-d); }

  .cm-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 760px) {
    .cm-body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  .cm-disasm {
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.7;
    padding: 14px 16px;
    max-height: 230px;
    overflow-y: auto;
    color: var(--muted);
    border-bottom: 1px solid var(--rule-soft);
    scroll-behavior: smooth;
  }
  @media (min-width: 760px) {
    .cm-disasm { border-bottom: 0; border-right: 1px solid var(--rule-soft); }
  }

  .cm-line {
    white-space: pre;
    padding-inline: 6px;
    border-radius: 2px;
    transition: background-color .12s linear, color .12s linear;
  }
  .cm-line.cmp { color: var(--ink-2); }
  .cm-line.on { background: color-mix(in srgb, var(--ch-b) 22%, transparent); color: var(--ch-b); }
  .cm-line.bad { background: color-mix(in srgb, var(--ch-alert) 26%, transparent); color: var(--ch-alert); }

  .cm-side {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cm-copy {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0;
    max-width: 46ch;
  }
  .cm-label { display: flex; flex-direction: column; gap: 6px; }
  .cm-label > span {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cm-label input {
    font-family: var(--mono);
    font-size: 15px;
    letter-spacing: .04em;
    padding: 11px 13px;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--surface-2);
    color: var(--ink);
    width: 100%;
  }
  .cm-label input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .cm.solved .cm-label input { border-color: var(--ch-d); color: var(--ch-d); }

  .cm-verdict {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    margin: 0;
    min-height: 1.5em;
  }
  .cm-verdict.bad { color: var(--ch-alert); }
  .cm-verdict.good { color: var(--ch-d); }

  .cm-spark {
    position: absolute;
    left: 84px;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ch-d);
    pointer-events: none;
    animation: cm-fly .9s ease-out forwards;
  }
  @keyframes cm-fly {
    from { transform: translate(0, 0) scale(1); opacity: 1; }
    to { transform: translate(var(--dx), var(--dy)) scale(0); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cm-line { transition: none; }
    .cm-spark { display: none; }
  }
</style>
