---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroDragon from '../components/HeroDragon.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.published - +a.data.published,
);

const FIELDS = [
  'Reverse engineering',
  'Game hacking',
  'Kernel & low-level',
  'Obfuscation & unpacking',
  'Algorithms & CP',
  'Machine learning',
  'CTF',
];
---

<Base
  title="0xpun337 — Puneet Mishra"
  description="Puneet Mishra. Reverse engineering, kernels, algorithms, machine learning — and writing about what's inside."
>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">Puneet Mishra</p>
      <h1 class="mark">0x<span>pun337</span></h1>
      <p class="thesis">
        I take things apart. Binaries, kernels, protocols, models —
        <em>whatever won't explain itself</em>.
      </p>

      <ul class="fields">
        {FIELDS.map((f) => <li>{f}</li>)}
      </ul>

      <HeroDragon />
    </div>
  </section>

  <section class="listing">
    <div class="wrap">
      <div class="series-head">
        <h2>Writing</h2>
        <span class="count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      </div>
      <ol class="index">
        {
          posts.map((p) => (
            <li>
              <a href={`/writing/${p.id}/`}>
                <span class="body">
                  <span class="t">{p.data.title}</span>
                  <span class="sub">{p.data.deck}</span>
                  <span class="meta">
                    {p.data.tags.join(' · ')} — {p.data.readingMinutes} min
                  </span>
                </span>
                <span class="go" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
    padding-block: clamp(40px, 7vw, 80px) clamp(36px, 5vw, 60px);
  }
  .hero .wrap {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* The loudest type on the site, and the only place it gets to be this big. */
  .mark {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(48px, 12vw, 132px);
    line-height: .94;
    letter-spacing: -.045em;
    color: var(--muted);
    margin-block: .12em .16em;
  }
  .mark span { color: var(--ink); }

  .thesis {
    font-size: clamp(19px, 2.3vw, 25px);
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 32ch;
    text-wrap: balance;
  }
  .thesis em { color: var(--accent); font-style: normal; }

  .fields {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-block: 26px 30px;
    padding: 0;
    list-style: none;
  }
  .fields li {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 6px 13px;
  }

  .listing { padding-block: clamp(40px, 6vw, 68px); }

  .series-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }
  .series-head h2 {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    margin: 0;
  }
  .count {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .index { list-style: none; padding: 0; margin: 0; }
  .index a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--rule-soft);
    text-decoration: none;
    color: inherit;
  }

  .body { display: flex; flex-direction: column; gap: 5px; }
  .t {
    font-family: var(--mono);
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 700;
    letter-spacing: -.01em;
    text-transform: uppercase;
    line-height: 1.2;
    transition: color .18s ease;
  }
  .sub {
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .meta {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 2px;
  }
  .go {
    font-family: var(--mono);
    color: var(--rule);
    padding-top: 4px;
    transition: color .18s ease, transform .18s ease;
  }
  .index a:hover .t,
  .index a:hover .go,
  .index a:focus-visible .t,
  .index a:focus-visible .go { color: var(--accent); }
  .index a:hover .go,
  .index a:focus-visible .go { transform: translateX(4px); }

  @media (max-width: 640px) {
    .go { display: none; }
    .index a { grid-template-columns: 1fr; }
  }
</style>
