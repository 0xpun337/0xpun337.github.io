---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroSignal from '../components/HeroSignal.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.part - b.data.part,
);

const series = [...new Set(posts.map((p) => p.data.series))].map((name) => ({
  name,
  entries: posts.filter((p) => p.data.series === name),
  total: posts.filter((p) => p.data.series === name)[0]?.data.partsTotal ?? 0,
}));
---

<Base
  title="0xpun337 — systems engineering notes"
  description="Rust, Linux syscalls, and getting data into PostgreSQL faster than it wants to go."
>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">Puneet Mishra — systems engineering</p>
      <h1 class="mark">0x<span>pun337</span></h1>
      <p class="thesis">
        Rust, Linux syscalls, and getting data into PostgreSQL
        <em>faster than it wants to go</em>.
      </p>
    </div>
    <HeroSignal />
    <div class="wrap">
      <p class="hero-caption">
        Above: a five-stage pipeline, idling. Red is a stall travelling upstream.
        It is the same simulation the posts below are about.
      </p>
    </div>
  </section>

  <section class="listing">
    <div class="wrap">
      {
        series.map((s) => (
          <div class="series">
            <div class="series-head">
              <h2>{s.name}</h2>
              <span class="count">
                {s.entries.length} of {s.total} published
              </span>
            </div>
            <ol class="index">
              {s.entries.map((p) => (
                <li>
                  <a href={`/writing/${p.id}/`}>
                    <span class="part">{String(p.data.part).padStart(2, '0')}</span>
                    <span class="body">
                      <span class="t">{p.data.title}</span>
                      <span class="sub">{p.data.deck}</span>
                      <span class="meta">
                        {p.data.tags.join(' · ')} — {p.data.readingMinutes} min
                      </span>
                    </span>
                    <span class="go" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
    padding-block: clamp(40px, 7vw, 84px) 0;
    overflow: hidden;
  }

  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* The wordmark is the loudest thing on the site, and the only place the
     type gets to be this big. Everything else stays quiet. */
  .mark {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(52px, 13vw, 148px);
    line-height: .92;
    letter-spacing: -.045em;
    color: var(--muted);
    margin-block: .12em .18em;
  }
  .mark span { color: var(--ink); }

  .thesis {
    font-size: clamp(19px, 2.4vw, 26px);
    line-height: 1.4;
    color: var(--ink-2);
    max-width: 26ch;
    text-wrap: balance;
  }
  .thesis em { color: var(--accent); font-style: normal; }

  .hero-signal {
    margin-block: clamp(28px, 5vw, 52px) 14px;
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 100%);
  }

  .hero-caption {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 22px;
    max-width: 62ch;
    line-height: 1.6;
  }

  .listing { padding-block: clamp(40px, 6vw, 72px); }

  .series + .series { margin-top: 56px; }

  .series-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }
  .series-head h2 {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    margin: 0;
  }
  .count {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .index a {
    display: grid;
    grid-template-columns: 4ch 1fr auto;
    align-items: start;
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--rule-soft);
    text-decoration: none;
    color: inherit;
  }

  .part {
    font-family: var(--mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--rule);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    transition: color .18s ease;
  }

  .body { display: flex; flex-direction: column; gap: 5px; }

  .t {
    font-family: var(--mono);
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 700;
    letter-spacing: -.01em;
    text-transform: uppercase;
    line-height: 1.2;
    transition: color .18s ease;
  }

  .sub {
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 62ch;
    text-wrap: pretty;
  }

  .meta {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 2px;
  }

  .go {
    font-family: var(--mono);
    color: var(--rule);
    padding-top: 4px;
    transition: color .18s ease, transform .18s ease;
  }

  .index a:hover .part,
  .index a:hover .t,
  .index a:hover .go,
  .index a:focus-visible .part,
  .index a:focus-visible .t,
  .index a:focus-visible .go {
    color: var(--accent);
  }
  .index a:hover .go,
  .index a:focus-visible .go {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .index a { grid-template-columns: 3ch 1fr; }
    .go { display: none; }
  }
</style>
