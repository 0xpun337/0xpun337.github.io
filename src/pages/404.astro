---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — 0xpun337" description="That page does not exist.">
  <article>
    <div class="wrap">
      <div class="col">
        <p class="eyebrow">404</p>
        <h1>No route to that page</h1>
        <p class="deck">
          The URL doesn't match anything here. It may have moved, or it may never
          have existed.
        </p>
        <p><a href="/">Back to the index</a></p>
      </div>
    </div>
  </article>
</Base>
